---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ArticleIndex from "../components/ArticleIndex.astro";
import { isArticleEntry, sortArticles } from "../lib/articles.js";
import { site } from "../lib/site";

const articles = sortArticles(await getCollection("docs", isArticleEntry));
---

<StarlightPage
  hasSidebar
  frontmatter={{
    title: site.title,
    description: site.description,
    pagefind: false,
    tableOfContents: false
  }}
>
  <div id="article-index">
    <ArticleIndex articles={articles} />
  </div>
</StarlightPage>

<style is:global>
  /* 首页不需要标题区，索引直接铺满内容区。 */
  main:has(#article-index) > .content-panel:first-child {
    display: none;
  }

  /*
   * 首页列表比正文宽一点（72rem = 1152px），列表行更好读。
   * 只写 max-width，不用 --sl-content-width，所以正文仍保持 960px。
   */
  main:has(#article-index) .sl-container {
    max-width: 72rem;
  }
</style>
