---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ArticleIndex from "../components/ArticleIndex.astro";
import { isArticleEntry, sortArticles } from "../lib/articles.js";
import { site } from "../lib/site";

const articles = sortArticles(await getCollection("docs", isArticleEntry));
---

<StarlightPage
  hasSidebar
  frontmatter={{
    title: site.title,
    description: site.description,
    pagefind: false,
    tableOfContents: false
  }}
>
  <div id="article-index">
    <ArticleIndex articles={articles} />
  </div>
</StarlightPage>

<style is:global>
  /* 首页不需要标题区，索引直接铺满内容区。 */
  main:has(#article-index) > .content-panel:first-child {
    display: none;
  }

  /*
   * 首页列表满屏：左右都贴到浏览器边沿，不做 60rem 居中。
   * 侧边栏收起时把 main-frame 的左侧内缩也归零，不然会留 2rem；
   * 展开时保留侧边栏占的宽度，否则正文会钻到侧边栏底下。
   */
  html[data-sidebar-collapsed="true"]:has(#article-index) {
    --sl-content-inline-start: 0rem;
  }

  @media (min-width: 50rem) {
    main:has(#article-index) .content-panel {
      padding-inline: 0;
    }

    main:has(#article-index) .sl-container {
      max-width: 100%;
    }
  }
</style>
