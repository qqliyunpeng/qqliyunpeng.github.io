---
import BaseLayout from "./BaseLayout.astro";
import { formatDate, tagUrl, type BlogPost } from "../lib/posts";

interface Props {
  post: BlogPost;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={post.data.title} description={post.data.description} canonicalPath={`/blog/${post.id}/`}>
  <article class="post" data-pagefind-body>
    <header class="post-header">
      <p class="eyebrow">文章</p>
      <h1>{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true">/</span>
              <span>更新于 {formatDate(post.data.updatedDate)}</span>
            </>
          )
        }
      </div>
      <div class="tag-row">
        {post.data.tags.map((tag) => <a href={tagUrl(tag)}>{tag}</a>)}
      </div>
    </header>

    {
      toc.length > 0 && (
        <nav class="toc" aria-label="文章目录">
          <h2>目录</h2>
          <ol>
            {toc.map((heading) => (
              <li class={`toc-depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
