---
import MobileMenuToggle from "@astrojs/starlight/components/MobileMenuToggle.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<script is:inline>
  (() => {
    let collapsed = true;
    try {
      collapsed = localStorage.getItem("starlight-sidebar-collapsed") !== "false";
    } catch {}

    if (collapsed) document.documentElement.dataset.sidebarCollapsed = "true";
    else delete document.documentElement.dataset.sidebarCollapsed;

    // 右侧目录默认展开，只有显式记住过折叠状态才收起（避免首屏闪一下）
    let tocCollapsed = false;
    try {
      tocCollapsed = localStorage.getItem("starlight-toc-collapsed") === "true";
    } catch {}

    if (tocCollapsed) document.documentElement.dataset.tocCollapsed = "true";
    else delete document.documentElement.dataset.tocCollapsed;
  })();
</script>

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
        <MobileMenuToggle />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
        <button
          class="sidebar-collapse-toggle print:hidden"
          type="button"
          aria-controls="starlight__sidebar"
          aria-expanded="true"
          aria-label="收起左侧栏"
        >
          <span class="sidebar-collapse-icon" aria-hidden="true">‹</span>
        </button>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<script>
  import {
    createHeaderScrollState,
    updateHeaderScrollState
  } from "../scripts/header-scroll-state.js";
  import { renderMermaidDiagrams } from "../scripts/mermaid-renderer.js";

  const storageKey = "starlight-sidebar-collapsed";
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(".sidebar-collapse-toggle");

  const renderState = (collapsed: boolean) => {
    if (collapsed) root.dataset.sidebarCollapsed = "true";
    else delete root.dataset.sidebarCollapsed;

    if (!toggle) return;
    toggle.ariaExpanded = String(!collapsed);
    toggle.ariaLabel = collapsed ? "展开左侧栏" : "收起左侧栏";
    const icon = toggle.querySelector<HTMLElement>(".sidebar-collapse-icon");
    if (icon) icon.textContent = collapsed ? "›" : "‹";
  };

  renderState(root.dataset.sidebarCollapsed === "true");

  toggle?.addEventListener("click", () => {
    const collapsed = root.dataset.sidebarCollapsed !== "true";
    renderState(collapsed);
    try {
      localStorage.setItem(storageKey, String(collapsed));
    } catch {}
  });

  const tocStorageKey = "starlight-toc-collapsed";

  // “本页内容”是 Starlight TableOfContents 里的 h2，我们不动它的结构，
  // 只在行尾挂一颗箭头，把目录列表折成手风琴。
  const tocHeading = document.querySelector<HTMLElement>(
    ".right-sidebar-panel #starlight__on-this-page"
  );
  const tocList = tocHeading?.parentElement?.querySelector<HTMLElement>("ul") ?? null;

  let tocToggle: HTMLButtonElement | null = null;

  if (tocHeading && tocList) {
    tocList.id = "starlight-toc-items";
    tocHeading.classList.add("toc-heading");

    // 标题文字包一层，折叠时只留图标（用视觉隐藏而不是 display:none，保住 nav 的可访问名）
    const label = document.createElement("span");
    label.className = "toc-heading-label";
    label.append(...tocHeading.childNodes);
    tocHeading.append(label);

    tocToggle = document.createElement("button");
    tocToggle.type = "button";
    tocToggle.className = "toc-toggle";
    tocToggle.setAttribute("aria-controls", tocList.id);
    // 图标用 Starlight 自带的 bars（恒显示），折叠状态靠颜色区分
    tocToggle.innerHTML =
      '<svg class="toc-toggle-icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M3 8h18a1 1 0 1 0 0-2H3a1 1 0 0 0 0 2Zm18 8H3a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Zm0-5H3a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Z"/></svg>';
    tocHeading.append(tocToggle);
  }

  const renderTocState = (collapsed: boolean) => {
    if (collapsed) root.dataset.tocCollapsed = "true";
    else delete root.dataset.tocCollapsed;

    if (!tocToggle) return;
    tocToggle.ariaExpanded = String(!collapsed);
    tocToggle.ariaLabel = collapsed ? "展开目录" : "收起目录";
  };

  renderTocState(root.dataset.tocCollapsed === "true");

  tocToggle?.addEventListener("click", () => {
    const collapsed = root.dataset.tocCollapsed !== "true";
    renderTocState(collapsed);
    try {
      localStorage.setItem(tocStorageKey, String(collapsed));
    } catch {}
  });

  const header = document.querySelector<HTMLElement>(".header");
  let headerScrollState = createHeaderScrollState(window.scrollY);

  const renderHeaderState = () => {
    root.toggleAttribute("data-header-hidden", headerScrollState.hidden);
  };

  window.addEventListener(
    "scroll",
    () => {
      const focusWithin = header?.contains(document.activeElement) ?? false;
      headerScrollState = updateHeaderScrollState(
        headerScrollState,
        window.scrollY,
        focusWithin
      );
      renderHeaderState();
    },
    { passive: true }
  );

  header?.addEventListener("focusin", () => {
    headerScrollState = updateHeaderScrollState(headerScrollState, window.scrollY, true);
    renderHeaderState();
  });

  void renderMermaidDiagrams();
</script>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
      transition-duration: var(--sidebar-collapse-duration);
      transition-property: transform;
      transition-timing-function: ease;
    }

    :global(html[data-header-hidden]) .header {
      transform: translateY(-100%);
    }

    @media (max-width: 49.999rem) {
      :global(mobile-starlight-toc nav) {
        transition-duration: var(--sidebar-collapse-duration);
        transition-property: transform;
        transition-timing-function: ease;
      }

      :global(html[data-header-hidden] mobile-starlight-toc nav) {
        transform: translateY(calc(-1 * (var(--sl-nav-height) + var(--sl-mobile-toc-height))));
      }
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    :global([aria-expanded="true"]) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: "";
        padding-bottom: 1px;
      }
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
    }

    .sidebar-collapse-toggle {
      display: none;
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }

      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }

      .sidebar-pane,
      .main-frame,
      .sidebar-collapse-toggle {
        transition-duration: var(--sidebar-collapse-duration);
        transition-property: inset-inline-start, padding-inline-start, transform;
        transition-timing-function: ease;
      }

      .sidebar-collapse-toggle {
        position: fixed;
        z-index: calc(var(--sl-z-index-menu) + 1);
        inset-block-start: calc(var(--sl-nav-height) + 1rem);
        inset-inline-start: calc(var(--sl-sidebar-width) - 0.875rem);
        display: grid;
        width: 1.75rem;
        height: 1.75rem;
        place-items: center;
        border: 1px solid var(--sl-color-hairline-shade);
        border-radius: 999px;
        background: var(--sl-color-bg);
        color: var(--sl-color-text-accent);
        cursor: pointer;
      }

      .sidebar-collapse-toggle:focus-visible {
        outline: 2px solid var(--sl-color-accent);
        outline-offset: 2px;
      }

      html[data-sidebar-collapsed="true"] .sidebar-pane {
        pointer-events: none;
        transform: translateX(-100%);
      }

      html[data-sidebar-collapsed="true"] .sidebar-collapse-toggle {
        inset-inline-start: 0.5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .header,
      :global(mobile-starlight-toc nav),
      .sidebar-pane,
      .main-frame,
      .sidebar-collapse-toggle {
        transition-duration: 0s;
      }
    }
  }
</style>

<style is:global>
  /*
   * Starlight 在 Page.astro 中用未分层的 [data-has-sidebar] 规则把 --sl-content-inline-start
   * 设为侧边栏宽度，分层（@layer starlight.core）里的收起态规则压不过它，导致收起后
   * 正文左侧仍留出整条侧边栏的空白。这里用未分层规则把收起态改成只留一点左侧间距。
   */
  @media (min-width: 50rem) {
    /*
     * 仿 fpga4fun：整站收进一个居中的「有效区域」，两侧留等宽空白。
     * 顶栏本身仍是满宽（背景和分隔线不断），只把内容缩进到带上。
     */
    :root {
      --site-max: 1600px;
      --band-offset: max(0px, calc((100vw - var(--site-max)) / 2));
    }

    header.header {
      padding-inline: calc(var(--band-offset) + var(--sl-nav-pad-x));
    }

    .sidebar-pane {
      inset-inline-start: var(--band-offset);
    }

    .sidebar-collapse-toggle {
      inset-inline-start: calc(var(--band-offset) + var(--sl-sidebar-width) - 0.875rem);
    }

    /* 收起时整条侧栏要移到屏幕外，用多出来的一段 band 偏移补上，避免位置跳变 */
    html[data-sidebar-collapsed="true"] .sidebar-pane {
      transform: translateX(calc(-100% - var(--band-offset)));
    }

    html[data-sidebar-collapsed="true"] .sidebar-collapse-toggle {
      inset-inline-start: calc(var(--band-offset) + 0.5rem);
    }

    html[data-has-sidebar] {
      --sl-content-inline-start: calc(var(--sl-sidebar-width) + var(--band-offset));
    }

    .main-frame {
      padding-inline-end: var(--band-offset);
    }

    html[data-has-sidebar][data-sidebar-collapsed="true"] {
      --sl-content-inline-start: calc(2rem + var(--band-offset));
    }
  }

  /*
   * 右侧目录折叠：脚本往 Starlight 的 TOC 标题行里注入一颗三横线图标，
   * 标题文字只留给读屏；折叠只收起列表，右栏宽度不变，正文不会跳动。
   */
  .toc-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* 标题文字只留给读屏（nav 的可访问名），界面上一律只显示三横线图标 */
  .toc-heading-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .toc-toggle {
    display: grid;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-inline-start: 0.5rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
  }

  .toc-toggle:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  .toc-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .toc-toggle-icon {
    display: block;
  }

  /* 图标方向不变，折叠后用强调色提示“目录已收起” */
  html[data-toc-collapsed="true"] .toc-toggle,
  html[data-toc-collapsed="true"] .toc-toggle:hover {
    color: var(--sl-color-text-accent);
  }

  html[data-toc-collapsed="true"] .right-sidebar-panel starlight-toc ul {
    display: none;
  }
</style>
