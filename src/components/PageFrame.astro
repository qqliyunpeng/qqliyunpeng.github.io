---
import MobileMenuToggle from "@astrojs/starlight/components/MobileMenuToggle.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<script is:inline>
  (() => {
    let collapsed = true;
    try {
      collapsed = localStorage.getItem("starlight-sidebar-collapsed") !== "false";
    } catch {}

    if (collapsed) document.documentElement.dataset.sidebarCollapsed = "true";
    else delete document.documentElement.dataset.sidebarCollapsed;
  })();
</script>

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
        <MobileMenuToggle />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
        <button
          class="sidebar-collapse-toggle print:hidden"
          type="button"
          aria-controls="starlight__sidebar"
          aria-expanded="true"
          aria-label="收起左侧栏"
        >
          <span class="sidebar-collapse-icon" aria-hidden="true">‹</span>
        </button>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<script>
  import {
    createHeaderScrollState,
    updateHeaderScrollState
  } from "../scripts/header-scroll-state.js";
  import { renderMermaidDiagrams } from "../scripts/mermaid-renderer.js";

  const storageKey = "starlight-sidebar-collapsed";
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(".sidebar-collapse-toggle");

  const renderState = (collapsed: boolean) => {
    if (collapsed) root.dataset.sidebarCollapsed = "true";
    else delete root.dataset.sidebarCollapsed;

    if (!toggle) return;
    toggle.ariaExpanded = String(!collapsed);
    toggle.ariaLabel = collapsed ? "展开左侧栏" : "收起左侧栏";
    const icon = toggle.querySelector<HTMLElement>(".sidebar-collapse-icon");
    if (icon) icon.textContent = collapsed ? "›" : "‹";
  };

  renderState(root.dataset.sidebarCollapsed === "true");

  toggle?.addEventListener("click", () => {
    const collapsed = root.dataset.sidebarCollapsed !== "true";
    renderState(collapsed);
    try {
      localStorage.setItem(storageKey, String(collapsed));
    } catch {}
  });

  // “本页内容”是 Starlight TableOfContents 里的 h2。桌面端把它改造成和手机端
  // 一样的一行胶囊：点整行才浮层展开目录，收起时随顶栏一起滑出视口。
  const tocHeading = document.querySelector<HTMLElement>(
    ".right-sidebar-panel #starlight__on-this-page"
  );
  const tocList = tocHeading?.parentElement?.querySelector<HTMLElement>("ul") ?? null;

  let tocToggle: HTMLButtonElement | null = null;

  if (tocHeading && tocList) {
    tocList.id = "starlight-toc-items";
    tocHeading.classList.add("toc-heading");

    // 标题文字包一层：胶囊里显示「本页内容」，同时保住 nav 的可访问名
    const label = document.createElement("span");
    label.className = "toc-heading-label";
    label.append(...tocHeading.childNodes);
    tocHeading.append(label);

    tocToggle = document.createElement("button");
    tocToggle.type = "button";
    tocToggle.className = "toc-toggle";
    tocToggle.setAttribute("aria-controls", tocList.id);
    // 图标和手机端一致：right-caret，展开时转 90° 朝下
    tocToggle.innerHTML =
      '<svg class="toc-toggle-icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="m14.83 11.29-4.24-4.24a1 1 0 1 0-1.42 1.41L12.71 12l-3.54 3.54a1 1 0 0 0 0 1.41 1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.24-4.24a1.002 1.002 0 0 0 0-1.42Z"/></svg>';
    tocHeading.append(tocToggle);
  }

  // 和手机端一样每次进来都是收起的单行胶囊，展开状态只在本次会话内保留
  let tocOpen = false;

  const renderTocState = (open: boolean) => {
    tocOpen = open;
    root.toggleAttribute("data-toc-open", open);

    if (!tocToggle) return;
    tocToggle.ariaExpanded = String(open);
    tocToggle.ariaLabel = open ? "收起目录" : "展开目录";
  };

  renderTocState(false);

  tocToggle?.addEventListener("click", () => renderTocState(!tocOpen));

  // 和手机端一样：点目录项、点胶囊外面、按 Esc 都收起浮层
  tocList?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) renderTocState(false);
  });

  document.addEventListener("click", (event) => {
    if (!tocOpen) return;
    if (event.target instanceof Node && tocHeading?.contains(event.target)) return;
    renderTocState(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !tocOpen) return;
    const hadFocus = tocHeading?.contains(document.activeElement) ?? false;
    renderTocState(false);
    if (hadFocus) tocToggle?.focus();
  });

  const header = document.querySelector<HTMLElement>(".header");
  let headerScrollState = createHeaderScrollState(window.scrollY);

  const renderHeaderState = () => {
    root.toggleAttribute("data-header-hidden", headerScrollState.hidden);
  };

  window.addEventListener(
    "scroll",
    () => {
      const focusWithin = header?.contains(document.activeElement) ?? false;
      headerScrollState = updateHeaderScrollState(
        headerScrollState,
        window.scrollY,
        focusWithin
      );
      renderHeaderState();
    },
    { passive: true }
  );

  header?.addEventListener("focusin", () => {
    headerScrollState = updateHeaderScrollState(headerScrollState, window.scrollY, true);
    renderHeaderState();
  });

  void renderMermaidDiagrams();
</script>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
      transition-duration: var(--sidebar-collapse-duration);
      transition-property: transform;
      transition-timing-function: ease;
    }

    :global(html[data-header-hidden]) .header {
      transform: translateY(-100%);
    }

    /* 手机端目录条在 72rem 以下都会显示，隐藏规则跟着 Starlight 的 lg 断点走 */
    @media (max-width: 71.999rem) {
      :global(mobile-starlight-toc nav) {
        transition-duration: var(--sidebar-collapse-duration);
        transition-property: transform;
        transition-timing-function: ease;
      }

      :global(html[data-header-hidden] mobile-starlight-toc nav) {
        transform: translateY(calc(-1 * (var(--sl-nav-height) + var(--sl-mobile-toc-height))));
      }
    }

    :global([data-has-sidebar]) .header {
      padding-inline-end: calc(
        var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
      );
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
      scrollbar-gutter: stable;
    }

    :global([aria-expanded="true"]) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .sidebar-content::after {
        content: "";
        padding-bottom: 1px;
      }
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: var(--sl-content-inline-start);
    }

    .sidebar-collapse-toggle {
      display: none;
    }

    @media (min-width: 50rem) {
      :global([data-has-sidebar]) .header {
        padding-inline-end: var(--sl-nav-pad-x);
      }

      .sidebar-pane {
        --sl-sidebar-visibility: visible;
        width: var(--sl-sidebar-width);
        background-color: var(--sl-color-bg-sidebar);
        border-inline-end: 1px solid var(--sl-color-hairline-shade);
      }

      .sidebar-pane,
      .main-frame,
      .sidebar-collapse-toggle {
        transition-duration: var(--sidebar-collapse-duration);
        transition-property: inset-inline-start, padding-inline-start, transform;
        transition-timing-function: ease;
      }

      .sidebar-collapse-toggle {
        position: fixed;
        z-index: calc(var(--sl-z-index-menu) + 1);
        inset-block-start: calc(var(--sl-nav-height) + 1rem);
        inset-inline-start: calc(var(--sl-sidebar-width) - 0.875rem);
        display: grid;
        width: 1.75rem;
        height: 1.75rem;
        place-items: center;
        border: 1px solid var(--sl-color-hairline-shade);
        border-radius: 999px;
        background: var(--sl-color-bg);
        color: var(--sl-color-text-accent);
        cursor: pointer;
      }

      .sidebar-collapse-toggle:focus-visible {
        outline: 2px solid var(--sl-color-accent);
        outline-offset: 2px;
      }

      html[data-sidebar-collapsed="true"] .sidebar-pane {
        pointer-events: none;
        transform: translateX(-100%);
      }

      html[data-sidebar-collapsed="true"] .sidebar-collapse-toggle {
        inset-inline-start: 0.5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .header,
      :global(mobile-starlight-toc nav),
      .sidebar-pane,
      .main-frame,
      .sidebar-collapse-toggle {
        transition-duration: 0s;
      }
    }
  }
</style>

<style is:global>
  /*
   * Starlight 在 Page.astro 中用未分层的 [data-has-sidebar] 规则把 --sl-content-inline-start
   * 设为侧边栏宽度，分层（@layer starlight.core）里的收起态规则压不过它，导致收起后
   * 正文左侧仍留出整条侧边栏的空白。这里用未分层规则把收起态改成只留一点左侧间距。
   */
  @media (min-width: 50rem) {
    /*
     * 仿 fpga4fun：整站收进一个居中的「有效区域」，两侧留等宽空白。
     * 顶栏本身仍是满宽（背景和分隔线不断），只把内容缩进到带上。
     */
    :root {
      --site-max: 1600px;
      --band-offset: max(0px, calc((100vw - var(--site-max)) / 2));
    }

    header.header {
      padding-inline: calc(var(--band-offset) + var(--sl-nav-pad-x));
    }

    .sidebar-pane {
      inset-inline-start: var(--band-offset);
    }

    .sidebar-collapse-toggle {
      inset-inline-start: calc(var(--band-offset) + var(--sl-sidebar-width) - 0.875rem);
    }

    /* 收起时整条侧栏要移到屏幕外，用多出来的一段 band 偏移补上，避免位置跳变 */
    html[data-sidebar-collapsed="true"] .sidebar-pane {
      transform: translateX(calc(-100% - var(--band-offset)));
    }

    html[data-sidebar-collapsed="true"] .sidebar-collapse-toggle {
      inset-inline-start: calc(var(--band-offset) + 0.5rem);
    }

    html[data-has-sidebar] {
      --sl-content-inline-start: calc(var(--sl-sidebar-width) + var(--band-offset));
    }

    .main-frame {
      padding-inline-end: var(--band-offset);
    }

    html[data-has-sidebar][data-sidebar-collapsed="true"] {
      --sl-content-inline-start: calc(2rem + var(--band-offset));
    }
  }

  /*
   * 桌面端右侧目录对齐手机端：一行「本页内容 ⌄」胶囊，点开才把目录浮层展开，
   * 收起状态下随顶栏一起滑出视口。右栏宽度始终保留，正文不会因为开合而跳动。
   */
  .toc-heading {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    padding-block: 0.5rem;
    padding-inline: 0.75rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: var(--sl-text-xs);
    font-weight: 400;
    line-height: 1;
    transition-duration: var(--sidebar-collapse-duration);
    transition-property: border-color, color;
    transition-timing-function: ease;
  }

  .toc-heading-label {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* 整行都能点：按钮铺满胶囊，箭头靠右，可聚焦元素只留一个 */
  .toc-toggle {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    padding: 0;
    padding-inline-end: 0.5rem;
    border: 0;
    border-radius: inherit;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  .toc-heading:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-2);
  }

  .toc-heading:hover .toc-toggle {
    color: var(--sl-color-white);
  }

  .toc-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .toc-toggle-icon {
    display: block;
    transition-duration: var(--sidebar-collapse-duration);
    transition-property: transform;
    transition-timing-function: ease;
  }

  html[data-toc-open] .toc-heading {
    border-color: var(--sl-color-accent);
  }

  html[data-toc-open] .toc-toggle-icon {
    transform: rotateZ(90deg);
  }

  @media (min-width: 72rem) {
    /* 原本是整屏固定的长栏，现在收成一颗随页面吸附的胶囊 */
    .right-sidebar {
      height: auto;
      overflow: visible;
      border-inline-start: 0;
      transition-duration: var(--sidebar-collapse-duration);
      transition-property: transform, visibility;
      transition-timing-function: ease;
    }

    /* 顶栏藏起来时展开态只跟着上移，收起态则整颗滑出视口 */
    html[data-header-hidden] .right-sidebar {
      transform: translateY(calc(-1 * var(--sl-nav-height)));
    }

    html[data-header-hidden]:not([data-toc-open]) .right-sidebar {
      transform: translateY(calc(-100% - var(--sl-nav-height)));
      visibility: hidden;
    }

    /* 展开后的目录浮层，观感对齐手机端下拉 */
    .right-sidebar-panel starlight-toc {
      position: relative;
      display: block;
    }

    .right-sidebar-panel starlight-toc > nav > ul {
      display: none;
    }

    html[data-toc-open] .right-sidebar-panel starlight-toc > nav > ul {
      position: absolute;
      z-index: calc(var(--sl-z-index-toc) + 1);
      inset-inline: 0;
      inset-block-start: calc(100% + 0.25rem);
      display: block;
      max-height: calc(100vh - var(--sl-nav-height) - 5.5rem);
      margin: 0;
      padding: 0.5rem 0.75rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      border: 1px solid var(--sl-color-gray-6);
      border-radius: 0.5rem;
      background-color: var(--sl-color-black);
      box-shadow: var(--sl-shadow-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .right-sidebar,
    .toc-heading,
    .toc-toggle-icon {
      transition-duration: 0s;
    }
  }
</style>
