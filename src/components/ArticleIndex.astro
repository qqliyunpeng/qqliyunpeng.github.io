---
import type { CollectionEntry } from "astro:content";

interface Props {
  articles: CollectionEntry<"docs">[];
}

const { articles } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
});

function formatDate(date: Date) {
  return dateFormatter.format(date).replaceAll("/", "-");
}
---

<ul class="article-index">
  {
    articles.map((article, index) => (
      <li>
        <a class="article" href={`/${article.id}/`}>
          <span class="article-number" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="article-title">{article.data.title}</span>
          {article.data.description && (
            <span class="article-description">{article.data.description}</span>
          )}
          <span class="article-meta">
            {article.data.pubDate && (
              <time datetime={article.data.pubDate.toISOString()}>{formatDate(article.data.pubDate)}</time>
            )}
            {article.data.tags.map((tag) => <span class="article-tag">{tag}</span>)}
          </span>
          <span class="article-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .article-index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .article-index li + li {
    border-top: 1px solid var(--sl-color-hairline);
  }

  .article {
    display: grid;
    grid-template-columns: 2.5rem auto minmax(0, 1fr) auto 2rem;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0.85rem;
    margin-inline: -0.85rem;
    color: inherit;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: background-color 150ms ease;
  }

  .article:hover {
    background: color-mix(in oklab, var(--sl-color-accent) 7%, transparent);
  }

  .article-number {
    align-self: center;
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-3);
  }

  .article-title {
    font-size: var(--sl-text-base);
    font-weight: 600;
    line-height: 1.4;
    color: var(--sl-color-white);
    white-space: nowrap;
  }

  .article:hover .article-title {
    color: var(--sl-color-accent-high);
  }

  :global([data-theme="dark"]) .article:hover .article-title {
    color: var(--sl-color-accent);
  }

  .article-description {
    min-width: 0;
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-3);
  }

  .article-tag {
    padding: 0 0.45rem;
    font-size: var(--sl-text-2xs);
    line-height: 1.6;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
  }

  .article-arrow {
    justify-self: end;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    opacity: 0;
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .article:hover .article-arrow {
    opacity: 1;
    transform: translateX(0.15rem);
  }

  /* 窄屏才隐藏简介，桌面/平板保持标题与简介同一行 */
  @media (max-width: 44rem) {
    .article-description {
      display: none;
    }

    .article {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      gap: 0.85rem;
      padding-inline: 0.6rem;
      margin-inline: -0.6rem;
    }

    .article-title {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .article-tag {
      display: none;
    }

    .article-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article,
    .article-arrow {
      transition: none;
    }
  }
</style>
